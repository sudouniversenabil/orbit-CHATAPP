# Keep the API bound to loopback unless you have deliberately secured it.
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ollama | openai | anthropic | gemini
ACTIVE_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI or any OpenAI-compatible endpoint (for example a local server).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# offline uses faster-whisper; cloud uses the OpenAI transcription endpoint.
STT_PROVIDER=offline
STT_MODEL=small
# Leave empty for automatic multilingual detection (including Bangla).
STT_LANGUAGE=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

WAKE_WORD=hey assistant
WAKE_WORD_ENABLED=false
TTS_ENABLED=false
# Optional substring of a pyttsx3 voice id, for example "english".
TTS_VOICE=

# Optional JSON object for providers added as plugins. Values are provider-specific.
CUSTOM_PROVIDER_CONFIG={}
